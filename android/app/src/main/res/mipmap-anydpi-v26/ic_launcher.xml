<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8 and up compose the launcher icon from two layers and mask them to
  whatever shape the launcher wants. The background is the flat brand blue; the
  foreground is the mark alone, rendered from `assets/logo.svg` at each density
  by `tools/make-android-icons.py` and drawn to the middle 60% so the mask
  cannot clip it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/accent" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
