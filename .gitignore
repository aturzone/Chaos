__pycache__/
models/
node_modules/
tools/routing/captures/
venv/
weights/

# The installer payload: built binaries staged for chaos-setup to embed.
# Regenerated by the release workflow; never committed.
stage/

# Gradle's build output for the Android client. Everything here is generated
# from `android/app/src`, and an APK plus its intermediates is tens of
# megabytes of churn per build.
android/.gradle/
android/build/
android/app/build/
android/local.properties

# **The JNI libraries are build output, not source.** `android/app/src/main/
# jniLibs/**/libchaos_android.so` is 490 KB per ABI produced by cross-compiling
# `android/jni`, and committing it would put a binary in the tree that nobody
# can review and that goes stale the moment the Rust changes. Build it with
# `scripts/build-android-jni.ps1`; the app runs without it as a client.
android/app/src/main/jniLibs/
