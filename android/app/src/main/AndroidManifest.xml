<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- It talks to one server on the local network and does nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        **Asked for only by the reader, and only when it is opened.** The
        scrying circle reads a QR code off another device's screen, which needs
        a camera; nothing else in the app does. `required="false"` so a device
        without one still installs and still gets everything except that one
        screen – a hard requirement here would delist the app for a tablet.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        **The engine is executed, not loaded.** `libchaos_serve.so` in
        jniLibs is the Chaos server built for Android; the app runs it as a
        child process exactly as the desktop window does. A file can only be
        executed if it is really on disk, so it must be extracted from the APK
        rather than mapped out of it.
    -->
    <application
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/ChaosTheme">

        <!--
            The dial is what launches. It asks the one question that decides
            what every other screen means, then starts MainActivity in that
            mode. MainActivity is no longer the launcher but is still exported
            so the dial can start it.
        -->
        <activity
            android:name=".ModeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            The mark and the reader, in a WebView over an origin the app
            answers itself. See BrandActivity: a camera is refused outside a
            secure context, and a node on a LAN is plain http forever.
        -->
        <activity
            android:name=".BrandActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
