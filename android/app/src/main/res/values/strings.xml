    <string name="app_name">Chaos</string>
    <string name="connect">CONNECT</string>
    <string name="send">SEND</string>
    <string name="not_connected">not connected</string>
    <!-- **8231, which is what the desktop actually serves on.** This said 8080
         for two releases: chaos-serve's own default, but not the port the
         window uses, so the placeholder told a user the wrong number for the
         one thing it exists to help them get right. -->
    <string name="hint_address">http://192.168.1.10:8231</string>
    <string name="hint_key">API key</string>
    <string name="hint_message">Ask something</string>

    <!-- The CHAOS section. Atur asked for a page that says what each device is
         to the others; on a phone that is a heading and two sentences, not a
         separate screen, because a phone screen is one column. -->
    <string name="chaos_title">CHAOS</string>
    <string name="chaos_note">The mode you chose decides what this screen offers. Change it with CHANGE MODE above.</string>

    <!-- The launch screen. Four detents, and the one that is chosen decides
         what the rest of the app shows. -->
    <string name="mode_title">WHAT IS THIS DEVICE?</string>
    <string name="mode_hint">Turn the dial. Everything else follows from this.</string>
    <string name="enter">ENTER</string>
    <string name="change_mode">CHANGE MODE</string>
    <string name="desc_alone">Only this device. Nothing else can reach it.</string>
    <string name="desc_client">Uses a CORE elsewhere. Loads nothing here.</string>
    <string name="desc_helper">Lends the memory and cores of this device to a CORE.</string>
    <string name="desc_core">Holds the models and answers. Others connect here.</string>

    <!-- One line per mode, shown on the main screen so it never contradicts
         the dial. The old text said "THIS PHONE IS A CLIENT" in every mode,
         including the ones where the phone was running a model itself. -->
    <string name="in_alone">Running a model on this phone. Nothing else can reach it.</string>
    <string name="in_core">Serving a model from this phone. Other devices can connect.</string>
    <string name="in_client">Using a CORE elsewhere. This phone loads nothing.</string>
    <string name="in_helper">Reserved. A CORE does not route work here yet.</string>

